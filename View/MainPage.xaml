<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Online_Movie_Searcher.MainPage"
             Title="Online Movie Searcher"
             BackgroundColor="#f0f0f0">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry x:Name="SearchEntry"
                       Grid.Column="0"
                       Placeholder="Zoek op titel..."
                       BackgroundColor="White"
                       TextColor="Black"
                       HeightRequest="45"
                       FontSize="14"
                       Margin="5.0" />

                <Button Text="Zoek"
                        Grid.Column="1"
                        Clicked="SearchMovie"
                        HeightRequest="45"
                        Padding="20,0"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>

            <CollectionView x:Name="MovieCollectionView"
                            Margin="0"
                            VerticalOptions="FillAndExpand"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Default=2, Tablet=3, Desktop=3}"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5"
                               CornerRadius="10"
                               HasShadow="True"
                               BackgroundColor="White"
                               Margin="5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovieTapped" CommandParameter="{Binding imdbID}"/>
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                                <Image Source="{Binding Poster}"
                                       WidthRequest="140"
                                       HeightRequest="200"
                                       Aspect="AspectFill" />

                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>

                                <Label Text="{Binding Year}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>